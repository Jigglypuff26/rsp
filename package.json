{
  "name": "rsp",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "main": "index.tsx",
  "author": "Maksim Vekovshinin",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/Jigglypuff26/rsp"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "web-vitals": "^6.0.0",
    "zustand": "^5.0.14"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "update": "npx npm-check-updates -u",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "code:check": "npm run lint && npm run format:check",
    "code:fix": "npm run lint:fix && npm run format",
    "docker:dev": "docker compose -f docker/docker-compose.dev.yml -p rsp-dev up --build",
    "docker:dev:bg": "docker compose -f docker/docker-compose.dev.yml -p rsp-dev up -d --build",
    "docker:dev:down": "docker compose -f docker/docker-compose.dev.yml -p rsp-dev down",
    "docker:dev:logs": "docker compose -f docker/docker-compose.dev.yml -p rsp-dev logs -f",
    "docker:prod": "docker compose -f docker/docker-compose.prod.yml -p rsp-prod up --build",
    "docker:prod:bg": "docker compose -f docker/docker-compose.prod.yml -p rsp-prod up -d --build",
    "docker:prod:down": "docker compose -f docker/docker-compose.prod.yml -p rsp-prod down",
    "docker:prod:logs": "docker compose -f docker/docker-compose.prod.yml -p rsp-prod logs -f"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/react-router-dom": "^5.3.3",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/ui": "^4.1.10",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-airbnb-typescript": "^18.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
